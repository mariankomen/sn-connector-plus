{
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "description": "ServiceNow SDK configuration schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Schema file to validate this configuration file"
        },
        "scope": {
            "type": "string",
            "minLength": 4,
            "maxLength": 18,
            "pattern": "^((x|sn)_[a-z0-9_]+|global)$",
            "description": "Scope of the application (example: 'x_myapp' or 'sn_myapp')"
        },
        "name": {
            "type": "string",
            "minLength": 4,
            "maxLength": 100,
            "description": "Name of the application (example: 'MyApp')"
        },
        "scopeId": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "pattern": "^([0-9a-f]{32}|global$)",
            "description": "Scope ID of the application (example: 'fc1b5713c3db3110d6489a038a40dd85')"
        },
        "entitiesDir": {
            "type": "string",
            "minLength": 1,
            "deprecated": true,
            "description": "DEPRECATED: Use 'fluentDir' instead"
        },
        "fluentDir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory containing .now.ts fluent files of the application",
            "default": "src/fluent"
        },
        "clientDir": {
            "type": "string",
            "description": "Directory containing client files of the application, such as HTML and TypeScript files. Set to empty to disable the client build.",
            "default": "src/client"
        },
        "generatedDir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory relative to 'fluentDir' where Fluent will generate files, such as keys.ts",
            "default": "generated"
        },
        "staticContentDir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory containing static asset files of the application",
            "default": "dist/static"
        },
        "staticContentPaths": {
            "type": "object",
            "description": "Mapping of source files to static output paths.",
            "patternProperties": {
                ".*": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "npmUpdateCheck": {
            "type": [
                "number",
                "boolean"
            ],
            "default": 10
        },
        "serverModulesDir": {
            "type": "string",
            "description": "Directory containing modular files to be built into sys_modules",
            "default": "src/server"
        },
        "serverModulesIncludePatterns": {
            "type": "array",
            "description": "Patterns to include when building server modules",
            "items": {
                "type": "string"
            },
            "default": [
                "**/*.ts",
                "**/*.tsx",
                "**/*.js",
                "**/*.jsx",
                "**/*.cts",
                "**/*.cjs",
                "**/*.mts",
                "**/*.mjs",
                "**/*.json"
            ]
        },
        "serverModulesExcludePatterns": {
            "type": "array",
            "description": "Patterns to exclude when building server modules",
            "items": {
                "type": "string"
            },
            "default": [
                "**/*.test.ts",
                "**/*.test.js",
                "**/*.d.ts"
            ]
        },
        "modulePaths": {
            "type": "object",
            "description": "Mapping between file glob patterns to resolve imported file paths to valid runtime paths. This is needed if your Fluent files are importing modules from a different location than the runtime modules. For example, if you have a custom TypeScript setup that transpiles modules from a 'src' directory to a 'dist' directory, you would need to specify that mapping here.",
            "patternProperties": {
                ".*": {
                    "type": "string"
                }
            }
        },
        "tsconfigPath": {
            "type": "string",
            "description": "Path to tsconfig file to be used for transpilation of server module typescript. ServiceNow SDK will emit build errors following the referenced tsconfig. (example: './src/server/tsconfig.json')"
        },
        "transpiledSourceDir": {
            "type": "string",
            "deprecated": true,
            "description": "DEPRECATED: Use 'modulePaths' instead"
        },
        "metadataDir": {
            "type": "string",
            "description": "Directory containing metadata xml for the app",
            "default": "metadata"
        },
        "appOutputDir": {
            "type": "string",
            "description": "Location to output built application for packaging during fluent build command",
            "default": "dist/app"
        },
        "packOutputDir": {
            "type": "string",
            "description": "Location to output the zip file during build process, to be later installed on the instance during install command",
            "default": "target"
        },
        "sourceDir": {
            "type": "string",
            "deprecated": true,
            "description": "DEPRECATED: This is no longer needed"
        },
        "ignoreTransformTableList": {
            "type": "array",
            "description": "List of tables to ignore when transforming entities to ServiceNow tables",
            "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z_\\d]+$"
            }
        },
        "trustedModules": {
            "type": "array",
            "description": "List of npm module patterns to mark as trusted. Trusted modules will have external_source set to false. Valid patterns: fully qualified package names (e.g., 'lodash', '@servicenow/sdk') or organization prefixes with wildcard (e.g., '@servicenow/*'). Blanket wildcards like '*' are not allowed.",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": [],
            "examples": [
                [
                    "@servicenow/*",
                    "lodash"
                ]
            ]
        },
        "dependencies": {
            "type": "object",
            "description": "Reference dependencies on other ServiceNow application tables and entities, organized by scope",
            "properties": {
                "applications": {
                    "type": "object",
                    "deprecated": true,
                    "description": "DEPRECATED: Use flat scope structure instead. Move scopes directly under 'dependencies'.",
                    "patternProperties": {
                        "^global$|^(x|sn)_[a-z0-9_]+$": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "tables": {
                                    "type": "array",
                                    "description": "List of tables that this application depends on (example: 'cmdb_ci')",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "pattern": "^[a-z_][a-z0-9_]*[a-z0-9]$"
                                    }
                                }
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "patternProperties": {
                "^((x|sn)_[a-z0-9_]+|global)$": {
                    "type": "object",
                    "description": "Dependencies for this scope",
                    "properties": {
                        "tables": {
                            "oneOf": [
                                {
                                    "const": "*"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "pattern": "^[a-z_][a-z0-9_]*$"
                                    }
                                }
                            ],
                            "description": "Table definitions from sys_db_object (list of table names or '*' for all)"
                        },
                        "roles": {
                            "oneOf": [
                                {
                                    "const": "*"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "pattern": "^[a-z_][a-z0-9_.]*$"
                                    }
                                }
                            ],
                            "description": "Role definitions from sys_user_role (list of role names or '*' for all)"
                        }
                    },
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "const": "*"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "pattern": "^[0-9a-f]{32}$"
                                }
                            }
                        ],
                        "description": "Custom table records (list of sys_ids or '*' for all)"
                    }
                }
            },
            "additionalProperties": false
        },
        "active": {
            "type": "boolean",
            "description": "Is the application active"
        },
        "accessControls": {
            "type": "object",
            "additionalProperties": false,
            "description": "Manage scoping restrictions and access to the application",
            "properties": {
                "scopedAdministration": {
                    "type": "boolean",
                    "description": "If true, System Admins will be prevented from accessing the application",
                    "default": false
                },
                "canEditInStudio": {
                    "type": "boolean",
                    "description": "Can the application be opened in developer studio",
                    "default": true
                },
                "runtimeAccessTracking": {
                    "type": "string",
                    "enum": [
                        "none",
                        "permissive",
                        "enforcing"
                    ],
                    "description": "Runtime access tracking for the application",
                    "default": "permissive"
                },
                "restrictTableAccess": {
                    "type": "boolean",
                    "description": "Restrict design time access to tables from outside the application",
                    "default": false
                },
                "private": {
                    "type": "boolean",
                    "description": "Mark the application as private",
                    "default": false
                },
                "trackable": {
                    "type": "boolean",
                    "description": "Mark the application as trackable",
                    "default": true
                },
                "uninstallBlocked": {
                    "type": "boolean",
                    "description": "Uninstall blocked for the application",
                    "default": false
                },
                "hideOnUI": {
                    "type": "boolean",
                    "description": "Application hidden in UI",
                    "default": false
                },
                "userRole": {
                    "type": "string",
                    "description": "Role required for end users to access the application and its tables",
                    "pattern": "^[0-9a-f]{32}$"
                }
            }
        },
        "jsLevel": {
            "type": "string",
            "enum": [
                "es_latest",
                "helsinki_es5",
                "traditional"
            ],
            "description": "JavaScript level for the application",
            "default": "es_latest"
        },
        "licensing": {
            "type": "object",
            "additionalProperties": false,
            "description": " If this application is licensable, set the subscription requirement and model.",
            "properties": {
                "licensable": {
                    "type": "boolean",
                    "description": "Mark package as licensable",
                    "default": true
                },
                "enforceLicense": {
                    "type": "string",
                    "enum": [
                        "none",
                        "log",
                        "enforce"
                    ],
                    "description": "Subscription requirement for the application",
                    "default": "log"
                },
                "licenseModel": {
                    "type": "string",
                    "enum": [
                        "none",
                        "fulfiller",
                        "producer",
                        "capacity",
                        "mixed",
                        "app_use"
                    ],
                    "description": "License model for the application",
                    "default": "none"
                },
                "licenseCategory": {
                    "type": "string",
                    "enum": [
                        "none",
                        "general",
                        "beta"
                    ],
                    "description": "License category for the application",
                    "default": "none"
                },
                "subscriptionEntitlement": {
                    "type": "string",
                    "description": "SysID of the subscription entitlement for the application",
                    "pattern": "^[0-9a-f]{32}$"
                }
            }
        },
        "menu": {
            "type": "string",
            "description": "SysID of the application's primary menu for default table modules",
            "pattern": "^[0-9a-f]{32}$"
        },
        "description": {
            "type": "string",
            "description": "Description of the application"
        },
        "logo": {
            "type": "string",
            "description": "SysID of the app logo",
            "pattern": "^[0-9a-f]{32}$"
        },
        "guidedSetupGuid": {
            "type": "string",
            "description": "SysID of the Guided Setup to start when the application is upgraded",
            "pattern": "^[0-9a-f]{32}$"
        },
        "installedAsDependency": {
            "type": "boolean",
            "description": "App was installed as a dependency",
            "default": false
        },
        "scripts": {
            "type": "object",
            "description": "Define scripts that are executed with the SDK task runner. The task functions are async and are passed APIs for cross-environment compatibility. Use prebuild to run a script before the build process for custom build tasks.",
            "patternProperties": {
                ".*": {
                    "type": "string",
                    "pattern": "\\.m?js$"
                }
            }
        },
        "tableOutputFormat": {
            "type": "string",
            "enum": [
                "bootstrap",
                "component"
            ],
            "default": "bootstrap",
            "description": "Artifact type built for table definitions. Traditional bootstrap or separate component records."
        },
        "tableDefaultLanguage": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z]{2,3}(-[a-zA-Z0-9]{2,8})*$",
            "default": "en",
            "description": "BCP 47 language tag for table/column documentation defaults. Used to resolve labels from multi-language documentation arrays (e.g., 'en', 'es', 'fr', 'en-US', 'zh-Hans')."
        },
        "packageResolverVersion": {
            "type": "string",
            "enum": [
                "1.0.0",
                "2.0.0"
            ],
            "default": "1.0.0",
            "description": "Rhino module resolver version. Must be 2.0.0+ for Global apps"
        },
        "type": {
            "type": "string",
            "enum": [
                "package",
                "configuration"
            ],
            "default": "package",
            "description": "Whether this project represents a scoped/global app package or a set of a record changes"
        },
        "taxonomy": {
            "type": "object",
            "description": "Configuration for taxonomy-based file organization",
            "properties": {
                "mapping": {
                    "type": "object",
                    "description": "Maps table names to their folder path for organization. Resulting files will be placed in '{generatedDir}/{path}'",
                    "additionalProperties": {
                        "type": "string",
                        "description": "Folder path for this table (e.g. 'server-development/business-rule' or 'integration/outbound/rest-api')",
                        "pattern": "^[a-z0-9_-]+(/[a-z0-9_-]+)*$"
                    },
                    "propertyNames": {
                        "pattern": "^[a-z0-9_]+$",
                        "description": "Table names should only contain lowercase alphanumeric characters and underscores"
                    }
                },
                "fallbackFolderName": {
                    "type": "string",
                    "description": "Folder name to use when a table doesn't have a mapping (lowercase, no spaces or special chars)",
                    "pattern": "^[a-z0-9_-]+$"
                }
            }
        }
    },
    "required": [
        "scope",
        "scopeId"
    ],
    "allOf": [
        {
            "not": {
                "required": [
                    "modulePaths",
                    "tsconfigPath"
                ],
                "errorMessage": "Cannot specify both 'modulePaths' and 'tsconfigPath'. Use 'tsconfigPath' to supply a custom tsconfig.json file to use for internal transpilation during build. Use 'modulePaths' to map paths from 'serverModulesDir' to output directory if using a separate transpilation step"
            },
            "errorMessage": "Cannot specify both 'modulePaths' and 'tsconfigPath'. Use 'tsconfigPath' to supply a custom tsconfig.json file to use for internal transpilation during build. Use 'modulePaths' to map paths from 'serverModulesDir' to output directory if using a separate transpilation step"
        },
        {
            "if": {
                "properties": {
                    "type": {
                        "const": "configuration"
                    }
                },
                "required": [
                    "type"
                ]
            },
            "then": {
                "not": {
                    "anyOf": [
                        {
                            "required": [
                                "serverModulesDir"
                            ]
                        },
                        {
                            "required": [
                                "tsconfigPath"
                            ]
                        },
                        {
                            "required": [
                                "packageResolverVersion"
                            ]
                        },
                        {
                            "required": [
                                "serverModulesIncludePatterns"
                            ]
                        },
                        {
                            "required": [
                                "serverModulesExcludePatterns"
                            ]
                        },
                        {
                            "required": [
                                "transpiledSourceDir"
                            ]
                        },
                        {
                            "required": [
                                "modulePaths"
                            ]
                        },
                        {
                            "required": [
                                "licensing"
                            ]
                        },
                        {
                            "required": [
                                "accessControls"
                            ]
                        },
                        {
                            "required": [
                                "menu"
                            ]
                        },
                        {
                            "required": [
                                "logo"
                            ]
                        },
                        {
                            "required": [
                                "guidedSetupGuid"
                            ]
                        },
                        {
                            "required": [
                                "guidedSetupGuid"
                            ]
                        },
                        {
                            "required": [
                                "tableOutputFormat"
                            ]
                        }
                    ],
                    "errorMessage": "A configuration project cannot include server module configuration or modify sys_app properties."
                },
                "errorMessage": "A configuration project cannot include server module configuration or modify sys_app properties."
            }
        }
    ]
}
