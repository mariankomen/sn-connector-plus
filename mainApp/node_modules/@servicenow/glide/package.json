{
  "name": "@servicenow/glide",
  "version": "27.0.4",
  "description": "Contains type declaration for Glide Scriptable APIs",
  "homepage": "https://www.servicenow.com/docs/csh?topicname=servicenow-sdk-landing&version=latest",
  "keywords": [
    "ServiceNow",
    "Fluent",
    "Typescript"
  ],
  "license": "MIT",
  "scripts": {
    "prebuild": "tsx ./exports.ts",
    "build": "tsc",
    "create-index": "ctix create -a ./src --noBackup --overwrite",
    "test": "npm run build && jest",
    "ci": "npm ci"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "!src/util/index.ts"
  ],
  "exports": {
    ".": "./src/types/index.js",
    "./*": "./src/*/index.js",
    "./util": "./src/util/index.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "24.9.2",
    "ctix": "1.8.2",
    "jest": "^29.7.0",
    "ts-morph": "20.0.0",
    "tsx": "^3.14.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
