{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist/browser",
    "rootDir": "./"
  },
  "include": ["src/**/*", "orogene/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
