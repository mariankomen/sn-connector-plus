{
  "name": "@servicenow/isomorphic-rollup",
  "version": "1.2.14",
  "description": "A set of rollup plugins that can run in Node and Browser environments",
  "exports": {
    ".": {
      "browser": "./dist/browser/index.js",
      "default": "./dist/index.js"
    },
    "./web-fs-loader": "./dist/browser/web-fs-loader.js",
    "./browser": "./dist/browser/index.js",
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "default": "./dist/resolver.js"
    }
  },
  "browser": "./dist/browser/index.js",
  "license": "MIT",
  "dependencies": {
    "@swc/core": "1.15.11",
    "sass": "1.86.3"
  },
  "optionalDependencies": {
    "rollup-plugin-dev": "2.1.0",
    "rollup-plugin-livereload": "2.0.5"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "6.10.1",
    "@rollup/browser": "4.43.0",
    "@rollup/plugin-commonjs": "26.0.3",
    "@rollup/plugin-inject": "5.0.5",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "6.0.2",
    "@rollup/plugin-typescript": "11.1.6",
    "@rollup/pluginutils": "5.0.1",
    "@servicenow/glider-lightning-fs": "1.0.2",
    "@servicenow/sdk-build-core": "4.0.0-alpha.7",
    "@swc/wasm-web": "1.15.11",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.16",
    "@types/mime-types": "2.1.4",
    "@types/node": "22.5.4",
    "@types/parse-filepath": "1.0.2",
    "@types/path-browserify": "1.0.3",
    "@types/picomatch": "2.3.4",
    "@types/resolve": "1.20.6",
    "@vscode/ts-package-manager": "0.0.2",
    "ast-matcher": "1.2.0",
    "commondir": "1.0.1",
    "css-select": "5.1.0",
    "deepmerge": "4.3.1",
    "dom-serializer": "2.0.0",
    "domhandler": "5.0.3",
    "escape-string-regexp": "5.0.0",
    "estree-walker": "2.0.2",
    "glob": "10.3.10",
    "htmlparser2": "10.0.0",
    "is-module": "1.0.0",
    "is-reference": "1.2.1",
    "jest": "30.2.0",
    "lodash": "4.17.21",
    "magic-string": "0.30.11",
    "mime-types": "2.1.35",
    "mkdirp": "3.0.1",
    "path-browserify": "1.0.1",
    "picomatch": "2.3.1",
    "prettier": "3.8.1",
    "resolve": "1.22.10",
    "rollup": "4.43.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-polyfill-node": "0.13.0",
    "rollup-plugin-serve": "1.1.1",
    "smob": "1.5.0",
    "ts-jest": "29.4.5",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "uuid": "10.0.0"
  },
  "scripts": {
    "ci": "pnpm install --frozen-lockfile && pnpm run lint && pnpm run build",
    "lint": "prettier . --check",
    "lint:fix": "prettier . --write",
    "test": "jest --coverage",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "prestart": "rm -rf dist && mkdirp dist/browser && cp public/* dist/browser",
    "start": "rollup --config rollup.config.test.cjs -w",
    "prebuild": "rm -rf dist ",
    "build": "rollup --config rollup.config.cjs"
  }
}