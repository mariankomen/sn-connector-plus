<?xml version="1.0" encoding="utf-8"?>
<database>
	<!-- SN App Store App Publish Failure Log -->
	<element name="sn_appstore_pending_user_onboard_log" type="collection" label="SN App Store Pending User Onboard Log" ws_access="false" alter_access="false" actions_access="false" read_access="true" update_access="false" create_access="false" delete_access="false" client_scripts_access="false">
		<element name="user" max_length="40"/>
		<element name="try_count" type="decimal" default_value="0"/>
