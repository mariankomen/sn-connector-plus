{
  "name": "@servicenow/sdk-api",
  "version": "4.4.0",
  "description": "ServiceNow SDK API",
  "license": "MIT",
  "main": "dist/index.js",
  "dependencies": {
    "@servicenow/isomorphic-rollup": "1.2.14",
    "crypto-js": "4.2.0",
    "fast-xml-parser": "5.3.7",
    "handlebars": "4.7.8",
    "lodash": "4.17.23",
    "zod": "3.22.4",
    "@servicenow/sdk-build-core": "4.4.0",
    "@servicenow/sdk-build-plugins": "4.4.0"
  },
  "devDependencies": {
    "@servicenow/commons-test-js-utils": "2.0.2",
    "@types/crypto-js": "4.2.2",
    "@types/ejs": "3.1.5",
    "@types/lodash": "4.17.23",
    "diff-js-xml": "1.0.8",
    "fast-glob": "3.3.2",
    "memfs": "4.17.2",
    "type-fest": "4.26.1",
    "unionfs": "4.6.0"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.8.0"
  },
  "scripts": {
    "prebuild": "pnpm run build-templates",
    "build": "tsc -b",
    "build-templates": "tsx esbuild.templates.ts",
    "watch": "tsc -b -w",
    "clean": "tsc -b --clean",
    "test": "export NODE_OPTIONS=\"--max-old-space-size=8192 --experimental-vm-modules\" && TS_NODE_PROJECT=\"tests/tsconfig.json\" jest --reporters=default --colors $(if [ -n \"$CI\" ]; then echo \"--maxWorkers=2\"; fi) --config=\"tests/jest.config.ts\" --silent"
  }
}