a745;\n  transition: background 0.2s;\n}\n\n.checklist-item:hover {\n  background: #e9ecef;\n}\n\n.checklist-icon {\n  flex-shrink: 0;\n  width: 24px;\n  height: 24px;\n  background: #28a745;\n  color: white;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: bold;\n  font-size: 14px;\n  margin-right: 15px;\n  margin-top: 2px;\n}\n\n.checklist-content {\n  flex: 1;\n}\n\n.checklist-content strong {\n  display: block;\n  color: #495057;\n  margin-bottom: 5px;\n  font-size: 15px;\n}\n\n.checklist-value {\n  color: #6c757d;\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n.support-quick-copy {\n  background: #e7f3ff;\n  padding: 25px;\n  border-radius: 8px;\n  border: 1px solid #b3d9ff;\n}\n\n.support-template {\n  position: relative;\n}\n\n.support-template pre {\n  background: white;\n  padding: 20px;\n  border-radius: 6px;\n  border: 1px solid #dee2e6;\n  overflow-x: auto;\n  font-family: "Courier New", monospace;\n  font-size: 13px;\n  line-height: 1.6;\n  color: #495057;\n  margin-bottom: 15px;\n  white-space: pre-wrap;\n  word-wrap: break-word;\n}\n\n.copy-button {\n  background: #0073e6;\n  color: white;\n  border: none;\n  padding: 12px 24px;\n  border-radius: 6px;\n  font-size: 15px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background 0.2s;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.copy-button:hover {\n  background: #0056b3;\n}\n\n.copy-button:active {\n  transform: scale(0.98);\n}\n\n@media (max-width: 768px) {\n  .support-info-grid {\n    grid-template-columns: 1fr;\n  }\n  .support-header h2 {\n    font-size: 1.5rem;\n  }\n  .support-section h3 {\n    font-size: 1.1rem;\n  }\n  .checklist-item {\n    padding: 12px;\n  }\n  .support-template pre {\n    font-size: 12px;\n    padding: 15px;\n  }\n  .copy-button {\n    width: 100%;\n    justify-content: center;\n  }\n}',"style"),insertStyle(".oauth-callback-container {\n  display: flex;\n  flex-direction: column;\n